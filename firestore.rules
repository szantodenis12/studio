
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    //=========== Collection Rules ============//

    /**
     * @description
     *   - Admins can read and write any user's profile.
     *   - Authenticated users can read, update and create their own profile.
     *   - Creation of a user profile is handled server-side or by trusted logic.
     */
    match /users/{userId} {
      allow read, update, create: if request.auth.uid == userId || isAdmin();
      allow list, delete: if isAdmin();
    }

    /**
     * @description
     *   Allows public read access to all room information but denies all
     *   write operations to prevent unauthorized data modification.
     */
    match /rooms/{roomId} {
      allow get, list: if true;
      allow create, update, delete: if false; // Managed by admins
    }
    
    /**
     * @description
     *   - Any user (authenticated or not) can create a new booking.
     *   - Admins can read, list, update, and delete any booking.
     *   - Non-admins cannot read or modify bookings.
     */
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, list, update, delete: if isAdmin();
    }

    /**
     * @description
     *   - Writing availability is part of the booking creation process.
     *   - Only admins should be able to read availability for management purposes.
     *   - We allow 'list' for anyone to check for booked dates on the client.
     */
    match /availability/{availabilityId} {
      allow list: if true; // Allows clients to check which dates are booked
      allow get, create, update, delete: if false; // Writes handled via booking transaction
    }
  }
}
