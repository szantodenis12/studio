rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // True when the caller has users/{uid}.role == 'admin'.
    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    //=========== Collection Rules ============//

    /**
     * users/{uid}
     *  - A signed-in user may create ONLY their own profile, and only as a plain
     *    user (no `role` field, or role == 'user'). Nobody can make themselves admin.
     *  - A user may read their own profile and update it, but never the `role` field.
     *  - Admins can read/list/update/delete any profile (and change roles).
     */
    match /users/{userId} {
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user')
      );
      allow get: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      allow list, delete: if isAdmin();
    }

    /**
     * rooms/{roomType}: public room catalogue (texts, prices, photos, inventory).
     * Public read; only admins may write.
     */
    match /rooms/{roomId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * bookings: guests create bookings ONLY through the `createBooking` Cloud
     * Function (Admin SDK, bypasses rules). Direct client access is admin-only.
     */
    match /bookings/{bookingId} {
      allow read, create, update, delete: if isAdmin();
    }

    /**
     * availability/{YYYY-MM-DD}: { date, <roomType>: bookedCount, blocked: { <roomType>: n } }
     * Public read (the booking calendar needs it); writes are admin-only
     * (the createBooking function writes with the Admin SDK).
     */
    match /availability/{availabilityId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * Legacy collection (unused by the current site). Public read, admin write.
     */
    match /roomTypes/{roomTypeId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin();
    }

    /**
     * The restaurant menu: public read, admin write.
     */
    match /menus/{menuId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
